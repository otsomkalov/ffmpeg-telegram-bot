{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "functionTimeout": "00:01:00",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Azure.Core": "Warning"
    }
  },
  "extensions": {
    "queues": {
      "maxDequeueCount": 1,
      "messageEncoding": "none"
    }
  }
}