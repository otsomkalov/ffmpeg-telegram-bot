<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
    <NoWarn>20</NoWarn>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="NewConversionTests.fs"/>
    <Compile Include="PreparedConversionTests.fs"/>
    <Compile Include="ConvertedConversionTests.fs"/>
    <Compile Include="ThumbnailedConversionTests.fs"/>
    <Compile Include="CompletedConversionTests.fs"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72"/>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0"/>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0"/>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Domain\Domain.fsproj"/>
  </ItemGroup>

</Project>
